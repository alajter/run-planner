{
  "name": "run-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync": "tsx --env-file=.env.local --conditions=react-server scripts/sync.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "plan": "tsx --env-file=.env.local --conditions=react-server scripts/plan.ts",
    "demo": "tsx scripts/demo.ts && DEMO=1 TURSO_DATABASE_URL=file:demo.db next dev -p 3200"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
