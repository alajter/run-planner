# Runalyze personal API token (Runalyze → Settings → Personal API)
RUNALYZE_TOKEN=
# The one login: a long passphrase (12+ characters)
APP_PASSPHRASE=
# Signs the session cookie: 32+ random characters (openssl rand -hex 32)
SESSION_SECRET=
# Vercel Cron sends this as a bearer token to /api/cron/sync (openssl rand -hex 24)
CRON_SECRET=
# Your time zone: decides what "today" is
ATHLETE_TZ=UTC
# Turso (production). Leave both empty locally: the app uses ./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
